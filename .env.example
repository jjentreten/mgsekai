# Gateway PIX: brutalcash (ativo) ou marchapay (legado, desativado por padrão)
PIX_PROVIDER=brutalcash

# BrutalCash - Chaves da API (painel "Credenciais API")
BRUTALCASH_PUBLIC_KEY=sua_public_key
BRUTALCASH_SECRET_KEY=sua_secret_key

# Marcha Pay (Marchabb) - Mantido para uso com PIX_PROVIDER=marchapay
MARCHABB_PUBLIC_KEY=pk_sua_chave_publica
MARCHABB_SECRET_KEY=sk_sua_chave_secreta

# Utmify - Trackeamento de vendas (Integrações > Webhooks > Credenciais de API)
UTMIFY_API_TOKEN=sua_credencial_utmify

# URL base do seu site (para postback e return)
# Ex: https://seusite.com ou http://localhost:3000
SITE_URL=http://localhost:3000

# Porta do servidor
PORT=3000
